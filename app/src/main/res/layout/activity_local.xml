<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv_bg"
    android:orientation="vertical">

    <!-- ============ BROWSER CHROME: row 1 transport, row 2 clear URL bar ============ -->
    <LinearLayout
        android:id="@+id/chromeBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lv_bg"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/lv_nav"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/lv_mut" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFwd"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/lv_nav"
                android:contentDescription="Forward"
                android:src="@drawable/ic_fwd"
                app:tint="@color/lv_mut" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnReload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/lv_nav"
                android:contentDescription="Reload"
                android:src="@drawable/ic_reload"
                app:tint="@color/lv_mut" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/tabsBadge"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/lv_nav"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_grid"
                    app:tint="@color/lv_acc" />

                <TextView
                    android:id="@+id/tabCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="monospace"
                    android:text="0"
                    android:textColor="@color/lv_acc"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/lv_nav"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu"
                app:tint="@color/lv_acc" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/urlBarBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/lv_urlbar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="8dp"
                android:paddingBottom="7dp">

                <TextView
                    android:id="@+id/portPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/lv_chip"
                    android:fontFamily="monospace"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text=":5173"
                    android:textColor="@color/lv_acc"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="localhost:PORT / path"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/lv_txt"
                    android:textColorHint="@color/lv_mut2"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGo"
                style="@style/Widget.LocalView.GhostButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                app:backgroundTint="@null"
                android:text="Go" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/lv_nav"
                android:contentDescription="Dashboard"
                android:src="@drawable/ic_home"
                app:tint="@color/lv_acc" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/chromeDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/lv_line_dim"
        android:visibility="gone" />

    <!-- Tab strip row (.tabs) -->
    <LinearLayout
        android:id="@+id/tabsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lv_panel"
        android:orientation="horizontal"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ DASHBOARD (index.html) ============ -->
        <LinearLayout
            android:id="@+id/dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- .topbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/lv_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/lv_nav"
                    android:contentDescription="LocalView"
                    android:padding="9dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/lv_acc" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="LocalView"
                        android:textColor="@color/lv_txt"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="LOCALHOST / FAST WEBVIEW"
                        android:textColor="@color/lv_mut"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/lv_chip"
                    android:fontFamily="monospace"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="v0.2"
                    android:textColor="@color/lv_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/lv_line_dim" />

            <!-- .quick -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp">

                <EditText
                    android:id="@+id/dashQuick"
                    style="@style/Widget.LocalView.UrlBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="port or url > 5173"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/dashGo"
                    style="@style/Widget.LocalView.GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:backgroundTint="@null"
                    android:text="Go" />
            </LinearLayout>

            <!-- .hero-mini -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/lv_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text=">_"
                    android:textColor="@color/lv_acc"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="LOCALHOST:PORT — INSTANT"
                    android:textColor="@color/lv_mut"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/lv_chip_on"
                    android:fontFamily="monospace"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:text="0.4s"
                    android:textColor="@color/lv_acc"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/lv_chip"
                    android:fontFamily="monospace"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:text="5 tabs"
                    android:textColor="@color/lv_mut"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- .section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@color/lv_acc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:text="LOCAL PROJECTS"
                    android:textColor="@color/lv_acc"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/projCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/lv_chip"
                    android:fontFamily="monospace"
                    android:paddingLeft="7dp"
                    android:paddingRight="7dp"
                    android:text="0"
                    android:textColor="@color/lv_mut"
                    android:textSize="10sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnAddTop"
                    style="@style/Widget.LocalView.GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    app:backgroundTint="@null"
                    android:text="+ ADD" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/projectList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp" />

            <Button
                android:id="@+id/btnAdd"
                style="@style/Widget.LocalView.GhostButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="14dp"
                app:backgroundTint="@null"
                android:text="+ Add localhost project" />
        </LinearLayout>

        <com.localview.browser.LocalWebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Floating restore key: only visible in maximized (borderless) mode -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            android:background="@drawable/lv_nav"
            android:contentDescription="Restore borders"
            android:src="@drawable/ic_minimize"
            android:visibility="gone"
            app:tint="@color/lv_acc" />
    </FrameLayout>

    <!-- ============ DEVTOOLS PANEL (dtpanel, in browser mode) ============ -->
    <LinearLayout
        android:id="@+id/dtPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B0F0C"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/lv_line_dim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=">_"
                android:textColor="@color/lv_acc"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dtPortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="monospace"
                android:text=":5173"
                android:textColor="@color/lv_acc"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/lv_chip"
                android:fontFamily="monospace"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="F12"
                android:textColor="@color/lv_mut"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/dtHtml"
                style="@style/Widget.LocalView.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/lv_chip_on"
                android:text="HTML"
                android:textColor="@color/lv_acc" />

            <Button
                android:id="@+id/dtJs"
                style="@style/Widget.LocalView.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/lv_chip"
                android:text="JS"
                android:textColor="@color/lv_mut" />

            <Button
                android:id="@+id/dtLog"
                style="@style/Widget.LocalView.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/lv_chip"
                android:text="LOG"
                android:textColor="@color/lv_mut" />

            <Button
                android:id="@+id/dtCopy"
                style="@style/Widget.LocalView.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/lv_chip"
                android:text="COPY"
                android:textColor="@color/lv_acc" />

            <Button
                android:id="@+id/dtClose"
                style="@style/Widget.LocalView.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/lv_chip"
                android:text="×"
                android:textColor="@color/lv_mut" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@color/lv_bg">

            <TextView
                android:id="@+id/dtCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="@color/lv_txt"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

    <!-- ============ DEV TOOLS BAR: the dock. F12 + view tools + hub ============ -->
    <LinearLayout
        android:id="@+id/devbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lv_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/lv_line_dim" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <Button
                    android:id="@+id/btnDevtools"
                    style="@style/Widget.LocalView.GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@null"
                    android:text="DEVTOOLS [F12]" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnMaximize"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/lv_nav"
                    android:contentDescription="Maximize page"
                    android:src="@drawable/ic_expand"
                    app:tint="@color/lv_acc" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnDesktop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/lv_nav"
                    android:contentDescription="Desktop view"
                    android:src="@drawable/ic_monitor"
                    app:tint="@color/lv_mut" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnTools"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/lv_nav"
                    android:contentDescription="All dev tools"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/lv_acc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="monospace"
                    android:text="TOOLS HUB ☰ FOR ALL"
                    android:textColor="@color/lv_mut2"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
