<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost button + brutalist hard shadow, exactly like .quick button / .open -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lv_shadow" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/lv_acc" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
