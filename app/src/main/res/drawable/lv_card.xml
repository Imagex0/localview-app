<?xml version="1.0" encoding="utf-8"?>
<!-- Card + 4px hard shadow, like .card / .hero -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lv_shadow" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lv_panel" />
            <stroke
                android:width="2dp"
                android:color="@color/lv_line_faint" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
